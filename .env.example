# Copy this file to .env.local for local development (Vite loads .env.local
# automatically; it's gitignored). Only VITE_-prefixed vars reach the browser.

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Not a secret — client IDs are safe to expose client-side.
# Remember to also enable the Google Drive API on the same project (APIs &
# Services → Library → Google Drive API → Enable), or sign-in works but
# loading/creating the data file fails with a 403.
VITE_GOOGLE_CLIENT_ID=

# --- Server-side only (used by functions/api/agent.ts, NEVER prefixed with VITE_) ---
# These fund the shared free "trial" experience for anyone who hasn't set up
# their own key in the app's Settings panel (bring-your-own-key). See
# CLAUDE.md's "Cost model / provider strategy". For local Pages Function
# emulation (or the local Vite dev fallback — see README.md), put these in a
# .dev.vars file instead (also gitignored). In production, set them as
# Cloudflare Pages secrets, not in any committed file.
#
# TRIAL_PROVIDER=gemini          # gemini (default, free tier) | groq | anthropic | mock (zero-cost, no key needed)
# TRIAL_API_KEY=                 # a free Gemini key from aistudio.google.com/apikey, unless using a different TRIAL_PROVIDER
# TRIAL_MODEL=                   # optional override; each provider has a sensible default

# Second tier of the shared trial's automatic failover chain (see §23 in
# Roadmap.md): tried only if TRIAL_PROVIDER above fails with a transient
# error (429/5xx). Leave unset to run with a single provider, same as
# before (no error if this is unset — it just means no fallback).
#
# NOTE (verified 2026-09-04): Groq is NOT currently a working fallback for
# the main request — every current Groq model with tool-calling support
# hard-rejects this app's full tool-schema payload on its free tier (its
# TPM/ITPM ceilings are 7,000-8,000; the payload is ~8,670-10,550 tokens
# depending on the model). §24 narrowed the per-request payload for
# confidently-classified messages (17-40% of the old full size), which
# should help most single-intent messages fit, but this still needs
# re-verification against Groq's real tokenizer before relying on it —
# don't just flip this on assuming §24 fixed it outright. Anthropic is a
# working alternative if you want a real second tier today (separate
# billing).
# TRIAL_FALLBACK_PROVIDER=
# TRIAL_FALLBACK_API_KEY=
# TRIAL_FALLBACK_MODEL=          # optional override; each provider has a sensible default

# Third, last-resort tier of the same failover chain (see §26 in
# Roadmap.md): Cloudflare Workers AI, tried only if both tiers above fail
# transiently. Unlike the other tiers, this isn't a generic provider slot —
# it's specifically Workers AI, called via its OpenAI-compatible REST
# endpoint (not the native `AI` binding — see providers/workersAI.ts for
# why), so it needs an account id as well as an API token. Leave both unset
# to run without this tier (no error either way). Real headroom is small
# (~145 requests/day on the free allocation, live-tested 2026-09-03) and
# latency is variable (3.1s-16.6s observed) — it exists to turn "every
# provider failed" into a slow-but-real answer, not as a primary tier.
# WORKERS_AI_ACCOUNT_ID=          # Cloudflare dashboard sidebar → Account ID (32-char hex)
# WORKERS_AI_API_TOKEN=           # a scoped API token with "Workers AI: Read" permission
# WORKERS_AI_MODEL=               # optional override; defaults to @cf/zai-org/glm-4.7-flash

# Funds the shared free voice-transcription trial (used by functions/api/transcribe.ts).
# Independent of TRIAL_PROVIDER/TRIAL_API_KEY above — voice has its own
# provider setting in the app (Settings panel) since Groq is the only
# supported speech-to-text option today. Can be the same physical key as
# TRIAL_API_KEY if that's already a Groq key, or a separate one.
# STT_TRIAL_API_KEY=             # a free Groq key from console.groq.com
