{
  // Cloudflare's dashboard now provisions new projects as a Worker (via
  // "Create app" + a GitHub connection, deploying with `wrangler deploy`),
  // not the older, separately-branded "Pages" product — see the git history
  // around 2026-09-02 for why this file exists instead of Pages' zero-config
  // functions/ directory. `assets.directory` serves the Vite build output;
  // any request that doesn't match a static file (i.e. /api/*) falls
  // through to the Worker script at `main`.
  "name": "habit-assistant",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-17",
  // §40: the app's one public address is https://habitassistant.app (a Custom
  // Domain attached in the dashboard). The shared *.workers.dev address is
  // switched off here rather than in the dashboard, which a deploy overwrites
  // (see the "vars" note below).
  "workers_dev": false,
  "assets": {
    "directory": "./dist"
  },
  // Non-secret runtime vars belong here, not only in the dashboard: a
  // dashboard-only "Text" variable does NOT carry forward into a new
  // version built by a Git-triggered `wrangler deploy` (learned 2026-09-03
  // the hard way — TRIAL_PROVIDER silently reverted to the code's "gemini"
  // fallback on the very next push, sending a Gemini key to Groq's API).
  // Secrets (TRIAL_API_KEY, TRIAL_FALLBACK_API_KEY, STT_TRIAL_API_KEY) stay
  // dashboard/CI-managed only — never put real key values in this file.
  //
  // TRIAL_FALLBACK_PROVIDER: §23's automatic cross-provider failover
  // (handleAgentRequest.ts). Groq, enabled 2026-10-08 after §58/§59 made
  // every request fit its free tier (8,000 tokens a minute per key; verified
  // live that day, including the two-step route for an unclassified
  // message). It takes effect only once TRIAL_FALLBACK_API_KEY exists as a
  // dashboard secret; without it this tier is skipped. Capacity is small:
  // one key for all trial users, so roughly one or two messages a minute
  // while Gemini is down.
  //
  // WORKERS_AI_ACCOUNT_ID/WORKERS_AI_API_TOKEN/WORKERS_AI_MODEL: §26's
  // third, last-resort tier (Cloudflare Workers AI). Verified end-to-end
  // 2026-09-08 — with both higher tiers deliberately forced to fail, this
  // tier produced a real successful reply, confirming the adapter and a
  // correctly-scoped token work together, not just the adapter in
  // isolation. Safe to enable via dashboard secrets (account id + scoped
  // API token — never in this file). See .env.example for what each var
  // does.
  "vars": {
    "TRIAL_PROVIDER": "gemini",
    "TRIAL_FALLBACK_PROVIDER": "groq"
  },
  // Enabled 2026-09-03 while debugging the Gemini tool-schema rejection —
  // without this, provider error bodies (logged via console.error in
  // handleAgentRequest.ts) go nowhere. Keeping it on: it's what let us find
  // the newCategoryId enum bug, and free tier covers 200K events/day.
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
