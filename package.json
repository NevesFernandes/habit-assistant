{
  "name": "habit-assistant",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "adb reverse tcp:5173 tcp:5173 && vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test:classify": "node src/server/classifyIntent.test.ts",
    "test:providerError": "node src/server/providerErrorMessage.test.ts",
    "test:payloadSize": "node src/server/payloadSize.test.ts",
    "test:routing": "node src/server/routing.test.ts",
    "test:keyRejected": "node src/server/keyRejected.test.ts",
    "test:recurrenceSpec": "node src/server/recurrenceSpec.test.ts",
    "test:confirmations": "node src/lib/confirmations.test.ts",
    "test:itemSelection": "node src/lib/itemSelection.test.ts",
    "test:futureCompletion": "tsx src/lib/futureCompletion.test.ts",
    "test:pause": "tsx src/lib/pause.test.ts",
    "test:heatmap": "tsx src/lib/heatmapWindow.test.ts",
    "test:markDone": "tsx src/lib/markDone.test.ts",
    "test:recurringChecklist": "tsx src/lib/recurringChecklist.test.ts",
    "test:checklistRemoval": "tsx src/lib/checklistRemoval.test.ts",
    "test:deviceOnlyKeys": "tsx src/lib/deviceOnlyKeys.test.ts",
    "test:dayParts": "tsx src/lib/dayParts.test.ts",
    "test:driveToken": "tsx src/lib/driveToken.test.ts",
    "test:weekStart": "tsx src/lib/weekStart.test.ts",
    "test:trialHint": "tsx src/lib/trialHint.test.ts",
    "test:taskCategory": "tsx src/lib/taskCategory.test.ts",
    "test:history": "tsx src/lib/history.test.ts",
    "test:dayNotes": "tsx src/lib/dayNotes.test.ts",
    "test:skip": "tsx src/lib/skip.test.ts",
    "test:taskStats": "tsx src/lib/taskStats.test.ts",
    "test:statsReset": "tsx src/lib/statsReset.test.ts",
    "test:historySummary": "tsx src/lib/historySummary.test.ts",
    "test:mcp": "tsx src/mcp/mcp.test.ts && tsx src/mcp/writeTools.test.ts && tsx src/mcp/manageTools.test.ts && tsx src/mcp/scenarios.test.ts",
    "test:chat": "tsx tests/chat/run.ts",
    "measure:payload": "tsx scripts/measurePayload.ts",
    "icons": "tsx scripts/generateIcons.ts",
    "screenshots": "tsx scripts/generateScreenshots.ts",
    "preview": "vite preview",
    "workers:dev": "npm run build && wrangler dev",
    "mcp:dev": "wrangler dev --config wrangler.mcp.jsonc --port 8788 --local-upstream localhost:8788 --var PUBLIC_ORIGIN:http://localhost:8788"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@ricky0123/vad-web": "^0.0.30",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true,
    "protobufjs@7.6.5": true
  }
}
