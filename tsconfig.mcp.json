{
  // The MCP Worker (wrangler.mcp.jsonc): Workers runtime types, no DOM. Its tests run
  // under Node and are checked by tsconfig.tests.json instead.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mcp.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/mcp/**/*.ts"],
  "exclude": ["src/mcp/**/*.test.ts", "src/mcp/testing/**"]
}
